# 应用基础
APP_NAME="OpenClaw 多实例管理"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true

# 安全
# 生产环境务必替换为强随机值: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-strong-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./runtime/app.db

# 默认管理员（首次启动自动创建；账号已存在则忽略）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# OpenClaw 集成
# mock=使用模拟实现; real=调用本地真实 openclaw 命令
OPENCLAW_RUNNER=mock
OPENCLAW_BIN=openclaw
# 任务 workspace 根目录（相对项目根）
OPENCLAW_WORKSPACE_ROOT=runtime/workspaces
# skills 源目录（相对项目根）
OPENCLAW_SKILLS_DIR=skills

# 加密 Lab4AI 凭证用的 Fernet key
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LAB4AI_CREDENTIAL_KEY=change-me-32-byte-urlsafe-base64-fernet-key====
